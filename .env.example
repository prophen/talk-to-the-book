# ElevenLabs (Scribe transcription + read-back narration). Server-side only.
# Get a key from your ElevenLabs account settings after subscribing.
ELEVENLABS_API_KEY=your_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_SCRIBE_MODEL=scribe_v2

# Gemma drafting. Local first by default.
# local = Ollama only, cloud = AI Studio only, auto = local, then cloud.
GEMMA_MODE=auto
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_LOCAL_MODEL=gemma4:12b-it-qat

# Cloud fallback (free key at https://aistudio.google.com/apikey)
GOOGLE_AI_STUDIO_KEY=your_key_here
# GEMMA_CLOUD_MODEL=gemma-4-31b-it

# Public address of the deployed app, so link previews get absolute image URLs.
# Not needed on Vercel, which supplies its production domain.
# NEXT_PUBLIC_SITE_URL=https://talk-to-the-book.example.com
